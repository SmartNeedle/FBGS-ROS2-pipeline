<?xml version="1.0"?>
<package format="3">
  <name>fbg_slicer_bridge</name>
  <version>0.1.0</version>
  <description>ROS 2 adapter that converts reconstructed needle shapes into SmartNeedle-compatible OpenIGTLink messages for 3D Slicer.</description>
  <maintainer email="you@example.com">FBG Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>ros2_igtl_bridge</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
